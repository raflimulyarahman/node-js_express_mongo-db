<div class="space-y-6">
    <!-- Hero Card -->
    <div class="bg-white p-8 sm:p-12 rounded-2xl shadow-sm border border-slate-200/80">

        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">
            Halo, <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-orange-500"><%= typeof nama !== 'undefined' ? nama : 'Teman' %></span>!
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            Selamat datang di web server Express. Layout ini sekarang diatur secara otomatis dan modular oleh <code class="px-2 py-0.5 rounded bg-slate-100 text-slate-800 text-sm font-mono">main-layout.ejs</code>.
        </p>
    </div>

    <!-- Section Daftar Mahasiswa -->
    <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Daftar Mahasiswa</h2>
                <p class="text-sm text-slate-500 mt-1">Data dikirim dinamis dari controller Express</p>
            </div>
            <% if (typeof mahasiswa !== 'undefined') { %>
                <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold">
                    Total: <%= mahasiswa.length %>
                </span>
            <% } %>
        </div>

        <% if (typeof mahasiswa !== 'undefined' && mahasiswa.length > 0) { %>
            <div class="overflow-x-auto rounded-xl border border-slate-100">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                            <th class="py-3.5 px-4 w-16">No</th>
                            <th class="py-3.5 px-4">Nama</th>
                            <th class="py-3.5 px-4">Email</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        <% mahasiswa.forEach((mhs, index) => { %>
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3.5 px-4 font-medium text-slate-400"><%= index + 1 %></td>
                                <td class="py-3.5 px-4 font-semibold text-slate-800 flex items-center gap-2">
                                    <%= mhs.nama %>
                                </td>
                                <td class="py-3.5 px-4 text-slate-500"><%= mhs.email %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="p-8 text-center text-slate-400 italic bg-slate-50 rounded-xl">
                Data mahasiswa belum tersedia.
            </div>
        <% } %>
    </div>
</div>