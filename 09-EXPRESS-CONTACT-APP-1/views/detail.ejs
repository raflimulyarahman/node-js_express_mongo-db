<div class="space-y-6">
  <section class="rounded-3xl bg-emerald-600 px-6 py-9 text-white shadow-xl shadow-emerald-600/15 sm:px-10">
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Detail Kontak</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-emerald-50">
      Informasi lengkap data kontak yang dipilih.
    </p>
  </section>
  <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
    <% if (typeof contact !== 'undefined' && contact) { %>
      <div class="space-y-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Nama</p>
          <p class="mt-1 text-lg font-bold text-slate-800"><%= contact.nama %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">No HP</p>
          <p class="mt-1 text-base text-slate-700"><%= contact.noHp %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Email</p>
          <p class="mt-1 text-base text-slate-700"><%= contact.email %></p>
        </div>
      </div>
      <div class="mt-8 flex justify-start">
        <a href="/contact"
          class="rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-900/10 transition hover:bg-slate-700">
          Kembali ke Daftar Kontak
        </a>
      </div>
    <% } else { %>
      <div class="rounded-xl bg-slate-50 p-8 text-center">
        <p class="text-base font-semibold text-slate-700">Kontak tidak ditemukan</p>
        <p class="mt-1 text-sm text-slate-500">Data dengan nama tersebut tidak ada di daftar kontak.</p>
        <div class="mt-6">
          <a href="/contact"
            class="rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-900/10 transition hover:bg-slate-700">
            Kembali ke Daftar Kontak
          </a>
        </div>
      </div>
    <% } %>
  </section>
</div>