<!DOCTYPE html>
<html lang="id" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Express App' %></title>

    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS v4 Browser CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="main.css">
</head>

<body class="ambient-bg text-slate-800 min-h-screen flex flex-col antialiased selection:bg-amber-100 selection:text-amber-900">

    <!-- Header & Navigation -->
    <header class="w-full pt-6 px-4 sm:px-6">
        <%- include('nav') %>
    </header>

    <!-- Main Content Area (Injected via express-ejs-layouts) -->
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 transition-all duration-300">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-slate-200/80 bg-white/70 backdrop-blur-md py-6 mt-12 text-slate-500 text-sm">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 font-medium text-slate-700">
                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                <span>Express Web Server</span>
                <span class="text-slate-300">|</span>
                <span class="text-xs text-slate-500">Node.js + EJS Layouts</span>
            </div>

            <p class="text-xs text-slate-400 text-center sm:text-right">
                &copy; <%= new Date().getFullYear() %> Belajar Node.js. All rights reserved.
            </p>
        </div>
    </footer>

</body>

</html>
