<div class="space-y-6">
    <section class="rounded-3xl bg-emerald-600 px-6 py-9 text-white shadow-xl shadow-emerald-600/15 sm:px-10"><p class="text-sm font-bold uppercase tracking-[0.2em] text-emerald-100">Contact directory</p><h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Daftar kontak</h1><p class="mt-3 max-w-2xl leading-relaxed text-emerald-50">Data ini dirender secara dinamis dari route Express dan ditampilkan sebagai tabel yang mudah dibaca.</p></section>
    <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8"><div class="mb-6 flex flex-wrap items-end justify-between gap-3"><div><p class="text-sm font-semibold text-emerald-600">Data mahasiswa</p><h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">Kontak yang tersimpan</h2></div><% if (typeof mahasiswa !== 'undefined') { %><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Total <%= mahasiswa.length %> orang</span><% } %></div>
        <% if (typeof mahasiswa !== 'undefined' && mahasiswa.length > 0) { %><div class="overflow-x-auto rounded-xl border border-slate-200"><table class="w-full min-w-[480px] text-left"><thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-4 py-3.5 font-bold">No</th><th class="px-4 py-3.5 font-bold">Nama</th><th class="px-4 py-3.5 font-bold">Email</th></tr></thead><tbody class="divide-y divide-slate-100 text-sm"><% mahasiswa.forEach((mhs, index) => { %><tr class="transition-colors hover:bg-emerald-50/50"><td class="px-4 py-4 font-semibold text-slate-400"><%= String(index + 1).padStart(2, '0') %></td><td class="px-4 py-4 font-bold text-slate-800"><%= mhs.nama %></td><td class="px-4 py-4 text-slate-500"><%= mhs.email %></td></tr><% }) %></tbody></table></div><% } else { %><div class="rounded-xl bg-slate-50 p-8 text-center text-slate-400">Belum ada data kontak.</div><% } %>
    </section>
</div>
