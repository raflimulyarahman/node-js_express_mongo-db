<div class="space-y-6">
  <section class="rounded-3xl bg-emerald-600 px-6 py-9 text-white shadow-xl shadow-emerald-600/15 sm:px-10">
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Detail Kontak</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-emerald-50">
      Informasi lengkap data kontak yang dipilih.
    </p>
  </section>
  <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
    <% if (typeof contact !== 'undefined' && contact) { %>
      <div class="space-y-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Nama</p>
          <p class="mt-1 text-lg font-bold text-slate-800"><%= contact.nama %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">No HP</p>
          <p class="mt-1 text-base text-slate-700"><%= contact.noHp %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Email</p>
          <p class="mt-1 text-base text-slate-700"><%= contact.email %></p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-start gap-3">
        <a href="/contact"
          class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
          Kembali ke Daftar Kontak
        </a>
        <a href="/contact/edit/<%= contact.nama %>"
          class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-900/10 transition hover:bg-slate-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
            <path
              d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
            <path
              d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
          </svg>
          Edit
        </a>
        <form action="/contact/delete/<%= contact.nama %>" method="POST" class="inline"
          onsubmit="return confirm('Yakin ingin menghapus kontak ini?')">
          <input type="hidden" name="_method" value="DELETE">
          <button type="submit"
            class="inline-flex items-center gap-2 rounded-xl bg-rose-600 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-rose-600/20 transition hover:bg-rose-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
              <path fill-rule="evenodd"
                d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482 41.03 41.03 0 0 0-2.365-.298V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c-.71 0-1.411.027-2.103.08V3.75c0-.69.56-1.25 1.25-1.25h1.706c.69 0 1.25.56 1.25 1.25v.33A41.1 41.1 0 0 0 10 4Zm.75 4a.75.75 0 0 0-1.5 0v6a.75.75 0 0 0 1.5 0V8Zm-3.5.75a.75.75 0 0 0-1.5 0v6a.75.75 0 0 0 1.5 0v-6Z"
                clip-rule="evenodd" />
            </svg>
            Hapus
          </button>
        </form>
      </div>
    <% } else { %>
      <div class="rounded-xl bg-slate-50 p-8 text-center">
        <p class="text-base font-semibold text-slate-700">Kontak tidak ditemukan</p>
        <p class="mt-1 text-sm text-slate-500">Data dengan nama tersebut tidak ada di daftar kontak.</p>
        <div class="mt-6">
          <a href="/contact"
            class="rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-900/10 transition hover:bg-slate-700">
            Kembali ke Daftar Kontak
          </a>
        </div>
      </div>
    <% } %>
  </section>
</div>