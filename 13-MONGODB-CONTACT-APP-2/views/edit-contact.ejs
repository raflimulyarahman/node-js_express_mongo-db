<div class="space-y-6">
    <section class="rounded-3xl bg-emerald-600 px-6 py-9 text-white shadow-xl shadow-emerald-600/15 sm:px-10">
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Edit Kontak</h1>
        <p class="mt-3 max-w-2xl leading-relaxed text-emerald-50">Ubah data kontak yang sudah tersimpan di daftar.</p>
    </section>

    <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div role="alert" class="mb-6 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 p-4 text-rose-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                class="mt-0.5 h-5 w-5 flex-shrink-0">
                <path fill-rule="evenodd"
                    d="M18 10A8 8 0 1 1 2 10a8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                    clip-rule="evenodd" />
            </svg>
            <div>
                <p class="text-sm font-bold">Ada yang belum beres nih:</p>
                <ul class="mt-1 list-disc space-y-0.5 pl-4 text-sm">
                    <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        </div>
        <% } %>

        <form action="/contact/update" method="POST" class="space-y-6">
            <input type="hidden" name="id" value="<%= contact._id || contact.id %>">
            <div class="space-y-2">
                <label for="nama" class="block text-sm font-bold text-slate-700">Nama</label>
                <input type="text" id="nama" name="nama" placeholder="Contoh: Sandhika Galih" autocomplete="off"
                    required autocapitalize="words" spellcheck="true"
                    onblur="this.value = this.value.replace(/\b\w/g, c => c.toUpperCase()).trim()"
                    value="<%= contact.nama %>"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10">
            </div>

            <div class="space-y-2">
                <label for="email" class="block text-sm font-bold text-slate-700">Email</label>
                <input type="email" id="email" name="email" placeholder="Contoh: sandhika@gmail.com" autocomplete="on"
                    required value="<%= contact.email %>"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10">
            </div>

            <div class="space-y-2">
                <label for="noHp" class="block text-sm font-bold text-slate-700">No HP</label>
                <input type="tel" id="noHp" name="noHp" placeholder="Contoh: 08123456789" autocomplete="off" required
                    value="<%= contact.noHp %>"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10">
            </div>

            <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
                <a href="/contact/<%= contact.nama %>"
                    class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-all duration-200 hover:bg-slate-50">
                    Batal
                </a>
                <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-md shadow-emerald-600/20 transition-all duration-200 hover:bg-emerald-700">
                    Simpan Perubahan
                </button>
            </div>
        </form>
    </section>
</div>
