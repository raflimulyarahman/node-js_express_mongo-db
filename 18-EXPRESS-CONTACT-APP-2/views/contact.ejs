<div class="space-y-6">
    <section class="rounded-3xl bg-emerald-600 px-6 py-9 text-white shadow-xl shadow-emerald-600/15 sm:px-10">
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Daftar kontak</h1>
        <p class="mt-3 max-w-2xl leading-relaxed text-emerald-50">Data ini dirender secara dinamis dari route Express
            dan ditampilkan sebagai tabel yang mudah dibaca.</p>
    </section>
    <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <div>
                <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">Kontak yang tersimpan</h2>
            </div>
            <div class="flex items-center gap-3">
                <% if (typeof contacts !=='undefined' ) { %><span
                        class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Total <%=
                            contacts.length %> orang</span>
                    <% } %>
                <a href="/contact/add"
                    class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white shadow-md shadow-emerald-600/20 transition-all duration-200 hover:bg-emerald-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                        <path
                            d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                    </svg>
                    Tambah Kontak
                </a>
            </div>
        </div>
        <% if (typeof contacts !=='undefined' && contacts.length> 0) { %><div
                class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full min-w-[480px] text-left">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                        <tr>
                            <th class="px-4 py-3.5 font-bold">No</th>
                            <th class="px-4 py-3.5 font-bold">Nama</th>
                            <th class="px-4 py-3.5 font-bold">No Hp</th>
                            <th class="px-4 py-3.5 font-bold text-right pr-11">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        <% contacts.forEach((contact, index)=> { %><tr class="transition-colors hover:bg-emerald-50/50">
                                <td class="px-4 py-4 font-semibold text-slate-400">
                                    <%= String(index + 1).padStart(2, '0' ) %>
                                </td>
                                <td class="px-4 py-4 font-bold text-slate-800">
                                    <%= contact.nama %>
                                </td>
                                <td class="px-4 py-4 text-slate-500">
                                    <%= contact.noHp %>
                                </td>
                                <td class="px-4 py-4 text-slate-500 text-right pr-6">
                                    <a href="/contact/<%= contact.nama %>"
                                        class="px-4 py-2 text-sm font-semibold badge rounded-full transition-all duration-200 <%= (typeof title !== 'undefined' && title === 'Halaman Contact') ? 'bg-slate-900 text-white shadow-md shadow-slate-900/20' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
                                        Detail
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="rounded-xl bg-slate-50 p-8 text-center text-slate-400">Belum ada data kontak.</div>
                <% } %>
    </section>
</div>